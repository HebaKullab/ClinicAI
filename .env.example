# Copy to .env and fill in your values. Do not commit .env.

# Whisper STT: small | medium | large (larger = better accuracy, slower)
WHISPER_MODEL=small

DASHBOARD_HOST=localhost
DASHBOARD_PORT=8000

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Use system HTTP_PROXY on Windows only if needed (often causes timeouts)
TELEGRAM_TRUST_ENV=false

# Primary LLM via OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-4.1-mini

# Fallback LLM via Google Gemini / Gemma
GEMINI_API_KEY=
LLM_FALLBACK_MODEL=gemma-4-31b-it

# Text-to-speech for voice replies: text | voice | both | auto
TTS_ENABLED=true
TTS_RESPONSE_MODE=auto
TTS_VOICE=ar-PS-SamaNeural
